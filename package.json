{
  "name": "bookmarks",
  "version": "1.0.0",
  "description": "Extensión multiplataforma para gestionar pestañas guardadas",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:extension && npm run build:shared && npm run build:api && npm run build:web",
    "build:extension": "tsc --noEmit && vite build",
    "build:shared": "npm run build --workspace @bookmarks/shared",
    "build:api": "npm run build --workspace @bookmarks/api",
    "build:web": "npm run build --workspace @bookmarks/web",
    "test": "npm run test --workspace @bookmarks/shared",
    "dev": "vite",
    "dev:api": "npm run start:dev --workspace @bookmarks/api",
    "dev:web": "npm run dev --workspace @bookmarks/web"
  },
  "private": true,
  "devDependencies": {
    "@types/chrome": "^0.1.29",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
